# Runtime configuration for the dashboard server. All values are optional —
# defaults are shown in the comments. `make setup` writes a working `.env` from
# this template with paths relative to the repo and a random cookie secret; the
# dashboard does not read `.env` itself, PM2 (ecosystem.config.cjs) loads it.

# Directory holding one subdirectory per scanned target, each containing a
# report.db written by duscan. Relative paths resolve against the repo root.
# Unset, it defaults to ../disk_scanner/reports — the sibling checkout, which is
# where reports land during development. Point it at wherever `duscan sync`
# delivers reports in production.
# DASHBOARD_REPORTS_DIR=/srv/duscan/reports

# Bind address. 0.0.0.0 listens on every interface so the dashboard is
# reachable by LAN IP. Put it behind a firewall or reverse proxy if the box is
# reachable beyond your network. Unset, the server binds 127.0.0.1 (loopback
# only); `make setup` writes 0.0.0.0 here.
# DASHBOARD_HOST=0.0.0.0

# HTTP port for the server (API + built web assets). Unset, the server falls back
# to 5310 — the dev API port, because Vite serves the UI on 5311 and proxies
# /api to it. `make setup` writes 5311, which is what production uses.
# DASHBOARD_PORT=5311

# Directory of built web assets to serve. Relative paths resolve against the
# repo root, so the same .env works on any machine.
# DASHBOARD_WEB_DIR=web/dist

# Path to the writable admin database (accounts, spaces, disks). Relative paths
# resolve against the repo root. Default: <repo>/server/admin.db
# DASHBOARD_ADMIN_DB=server/admin.db

# Secret used to sign session cookies. If unset, a fresh random key is generated
# on every process start — so set it to keep sessions valid across restarts.
# `make setup` fills this with a random value; leave it to keep sessions alive.
# DASHBOARD_COOKIE_SECRET=change-me

# Set to true when the dashboard sits behind an HTTPS reverse proxy, so the admin
# session cookie is marked Secure and never sent over plain HTTP.
# DASHBOARD_COOKIE_SECURE=false

# Fastify log level: trace | debug | info | warn | error | fatal.
# DASHBOARD_LOG_LEVEL=info

# Whether the reverse proxy's X-Forwarded-For header is trusted to name the real
# client. Default false, and it should stay false whenever the server is
# reachable without a proxy that overwrites the header: trusting a header any LAN
# peer can set would let them fake their IP and bypass the admin login rate
# limit. Set to true (or a hop count) ONLY when nginx terminates the connection
# and overwrites the header.
# DASHBOARD_TRUST_PROXY=false

# API requests allowed per client IP per minute before the server answers 429; 0
# disables the limiter. The report endpoints are unauthenticated, so this is the
# in-app stop for a loop if the port is ever reachable without nginx rate-limiting
# it. Default: 1800 (30/s per IP).
# DASHBOARD_API_RATE_LIMIT=1800
