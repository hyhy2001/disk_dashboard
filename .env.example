# Runtime configuration for the dashboard server. All values are optional —
# defaults are shown in the comments. `make setup` writes a working `.env` from
# this template with paths relative to the repo and a random cookie secret; the
# dashboard does not read `.env` itself, PM2 (ecosystem.config.cjs) loads it.

# Bind address. Loopback by default: the dashboard exposes filesystem usage and
# has its own auth, so binding 0.0.0.0 must be an explicit choice.
# DASHBOARD_HOST=127.0.0.1

# HTTP port for the server (API + built web assets).
# DASHBOARD_PORT=5311

# Directory of built web assets to serve. Unset = API-only.
# DASHBOARD_WEB_DIR=/www/wwwroot/disk.hydev.me/disk_dashboard/web/dist

# Path to the writable admin database (accounts, spaces, disks).
# Default: <repo>/server/admin.db
# DASHBOARD_ADMIN_DB=/www/wwwroot/disk.hydev.me/disk_dashboard/server/admin.db

# Secret used to sign session cookies. If unset, a fresh random key is generated
# on every process start — so set it to keep sessions valid across restarts.
# `make setup` fills this with a random value; leave it to keep sessions alive.
# DASHBOARD_COOKIE_SECRET=change-me

# Fastify log level: trace | debug | info | warn | error | fatal.
# DASHBOARD_LOG_LEVEL=info
